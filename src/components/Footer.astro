---
import { LINKS, VERSION, prefix } from "../lib/site.mjs";
import { UI } from "../i18n/ui.mjs";

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const T = UI[lang];
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot-brand"><img src="/assets/logo.svg" alt="" width="18" height="18"><span>ptah.run · <span class="v" data-version>{VERSION}</span> · pre-GA · MIT · © 2026 Stokaro</span></div>
    <ul class="foot-links">
      <li><a href={LINKS.github}>GitHub</a></li>
      <li><a href={LINKS.issues}>{T.footIssues}</a></li>
      <li><a href={`${prefix(lang)}/community/`}>{T.footCommunity}</a></li>
      <li><a href={LINKS.releases}>{T.footChangelog}</a></li>
      <li><a href={LINKS.license}>{T.footLicense}</a></li>
    </ul>
    {T.footNote && <p class="foot-note">{T.footNote}</p>}
  </div>
</footer>
