---
/* The operator's reconcile loop from the 5a design. */
interface Props { c: any }
const { c } = Astro.props;
---
<svg viewBox="0 0 680 340" width="680" height="340" style="background:var(--bg);font-family:var(--mono)" role="img" aria-label={c.aria}><defs><marker id="rl5-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 1 L8 5 L0 9 z" style="fill:var(--fg2)"></path></marker><marker id="rl5-arrow-amber" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 1 L8 5 L0 9 z" style="fill:var(--amber)"></path></marker></defs><circle cx="340" cy="178" r="108" style="fill:none;stroke:var(--line);stroke-dasharray:2 4"></circle><path d="M 361.5 72.2 A 108 108 0 0 1 406.0 92.5" style="fill:none;stroke:var(--fg2);stroke-width:1.5" marker-end="url(#rl5-arrow)"></path><path d="M 436.1 128.8 A 108 108 0 0 1 448.0 176.3" style="fill:none;stroke:var(--fg2);stroke-width:1.5" marker-end="url(#rl5-arrow)"></path><path d="M 438.4 222.5 A 108 108 0 0 1 408.6 261.4" style="fill:none;stroke:var(--fg2);stroke-width:1.5" marker-end="url(#rl5-arrow)"></path><path d="M 366.6 282.7 A 108 108 0 0 1 317.6 283.7" style="fill:none;stroke:var(--fg2);stroke-width:1.5" marker-end="url(#rl5-arrow)"></path><path d="M 274.7 264.1 A 108 108 0 0 1 243.4 226.4" style="fill:none;stroke:var(--amber);stroke-width:1.5" marker-end="url(#rl5-arrow-amber)"></path><path d="M 232.0 180.6 A 108 108 0 0 1 242.0 132.7" style="fill:none;stroke:var(--fg2);stroke-width:1.5" marker-end="url(#rl5-arrow)"></path><path d="M 270.6 95.2 A 108 108 0 0 1 314.3 73.1" style="fill:none;stroke:var(--fg2);stroke-width:1.5" marker-end="url(#rl5-arrow)"></path><text x="340" y="172" text-anchor="middle" style="font:600 12px var(--mono);fill:var(--fg);letter-spacing:.12em">{c.reconcile}</text><text x="340" y="190" text-anchor="middle" style="font:11px var(--mono);fill:var(--mute)">{c.every}</text><text x="340" y="206" text-anchor="middle" style="font:11px var(--mono);fill:var(--mute)">{c.afterApply}</text><circle cx="340.0" cy="70.0" r="13" style="fill:var(--bg);stroke:var(--fg2);stroke-width:1.5"></circle><text x="340.0" y="70.0" text-anchor="middle" dominant-baseline="central" style="font:600 11px var(--mono);fill:var(--fg)">01</text><text x="340.0" y="38.0" text-anchor="middle" style="font:500 13px var(--mono);fill:var(--fg)">{c.steps[0]}</text><circle cx="424.4" cy="110.7" r="13" style="fill:var(--bg);stroke:var(--fg2);stroke-width:1.5"></circle><text x="424.4" y="110.7" text-anchor="middle" dominant-baseline="central" style="font:600 11px var(--mono);fill:var(--fg)">02</text><text x="447.9" y="90.0" text-anchor="start" style="font:500 13px var(--mono);fill:var(--fg)">{c.steps[1]}</text><circle cx="445.3" cy="202.0" r="13" style="fill:var(--bg);stroke:var(--fg2);stroke-width:1.5"></circle><text x="445.3" y="202.0" text-anchor="middle" dominant-baseline="central" style="font:600 11px var(--mono);fill:var(--fg)">03</text><text x="474.5" y="212.7" text-anchor="start" style="font:500 13px var(--mono);fill:var(--fg)">{c.steps[2]}</text><circle cx="386.9" cy="275.3" r="13" style="fill:var(--bg);stroke:var(--fg2);stroke-width:1.5"></circle><text x="386.9" y="275.3" text-anchor="middle" dominant-baseline="central" style="font:600 11px var(--mono);fill:var(--fg)">04</text><text x="399.9" y="314.3" text-anchor="start" style="font:500 13px var(--mono);fill:var(--fg)">{c.steps[3]}</text><circle cx="293.1" cy="275.3" r="13" style="fill:var(--amber);stroke:var(--amber);stroke-width:1.5"></circle><text x="293.1" y="275.3" text-anchor="middle" dominant-baseline="central" style="font:600 11px var(--mono);fill:#fff">05</text><text x="280.1" y="314.3" text-anchor="end" style="font:500 13px var(--mono);fill:var(--amber)">{c.steps[4]}</text><circle cx="234.7" cy="202.0" r="13" style="fill:var(--bg);stroke:var(--fg2);stroke-width:1.5"></circle><text x="234.7" y="202.0" text-anchor="middle" dominant-baseline="central" style="font:600 11px var(--mono);fill:var(--fg)">06</text><text x="205.5" y="212.7" text-anchor="end" style="font:500 13px var(--mono);fill:var(--fg)">{c.steps[5]}</text><circle cx="255.6" cy="110.7" r="13" style="fill:var(--bg);stroke:var(--fg2);stroke-width:1.5"></circle><text x="255.6" y="110.7" text-anchor="middle" dominant-baseline="central" style="font:600 11px var(--mono);fill:var(--fg)">07</text><text x="232.1" y="90.0" text-anchor="end" style="font:500 13px var(--mono);fill:var(--fg)">{c.steps[6]}</text><path d="M 282.0 68.0 L 318.0 68.0" style="stroke:var(--mute);stroke-width:1.2" marker-end="url(#rl5-arrow)"></path><text x="276.0" y="72.0" text-anchor="end" style="font:11px var(--mono);fill:var(--mute);letter-spacing:.08em">{c.start}</text></svg>
