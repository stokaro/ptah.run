---
/* The "How it works" pipeline, drawn in the 5a design. Only the labels are
 * the page's words; file names and commands are what they are. */
interface Props { c: any }
const { c } = Astro.props;
---
<svg viewBox="0 0 1184 320" width="1184" height="320" role="img" aria-label={c.aria}><defs><marker id="pl-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 1 L8 5 L0 9 z" style="fill:var(--fg2)"></path></marker><marker id="pl-arrow-amber" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 1 L8 5 L0 9 z" style="fill:var(--amber)"></path></marker></defs><text x="115" y="41" text-anchor="middle" style="font:11px var(--mono);fill:var(--mute);letter-spacing:.04em">{c.sources}</text><rect x="40" y="57" width="150" height="26" rx="2" style="fill:var(--bg);stroke:var(--line);stroke-width:1.2"></rect><text x="115" y="70" text-anchor="middle" dominant-baseline="central" style="font:12.5px var(--mono);fill:var(--fg)">schema.sql</text><path d="M 190 70 C 245 70, 245 160, 300 160" style="fill:none;stroke:var(--mute);stroke-width:1.2;" marker-end="url(#pl-arrow)"></path><rect x="40" y="93" width="150" height="26" rx="2" style="fill:var(--bg);stroke:var(--line);stroke-width:1.2"></rect><text x="115" y="106" text-anchor="middle" dominant-baseline="central" style="font:12.5px var(--mono);fill:var(--fg)">schema.yaml</text><path d="M 190 106 C 245 106, 245 160, 300 160" style="fill:none;stroke:var(--mute);stroke-width:1.2;" marker-end="url(#pl-arrow)"></path><rect x="40" y="129" width="150" height="26" rx="2" style="fill:var(--bg);stroke:var(--line);stroke-width:1.2"></rect><text x="115" y="142" text-anchor="middle" dominant-baseline="central" style="font:12.5px var(--mono);fill:var(--fg)">schema.hcl</text><path d="M 190 142 C 245 142, 245 160, 300 160" style="fill:none;stroke:var(--mute);stroke-width:1.2;" marker-end="url(#pl-arrow)"></path><rect x="40" y="165" width="150" height="26" rx="2" style="fill:var(--bg);stroke:var(--line);stroke-width:1.2"></rect><text x="115" y="178" text-anchor="middle" dominant-baseline="central" style="font:12.5px var(--mono);fill:var(--fg)">schema.dbml</text><path d="M 190 178 C 245 178, 245 160, 300 160" style="fill:none;stroke:var(--mute);stroke-width:1.2;" marker-end="url(#pl-arrow)"></path><rect x="40" y="201" width="150" height="26" rx="2" style="fill:var(--bg);stroke:var(--line);stroke-width:1.2"></rect><text x="115" y="214" text-anchor="middle" dominant-baseline="central" style="font:12.5px var(--mono);fill:var(--fg)">models/*.go</text><path d="M 190 214 C 245 214, 245 160, 300 160" style="fill:none;stroke:var(--mute);stroke-width:1.2;" marker-end="url(#pl-arrow)"></path><rect x="40" y="237" width="150" height="26" rx="2" style="fill:var(--bg);stroke:var(--line);stroke-width:1.2"></rect><text x="115" y="250" text-anchor="middle" dominant-baseline="central" style="font:12.5px var(--mono);fill:var(--fg)">orm loader · stdout</text><path d="M 190 250 C 245 250, 245 160, 300 160" style="fill:none;stroke:var(--mute);stroke-width:1.2;" marker-end="url(#pl-arrow)"></path><rect x="300" y="142" width="170" height="36" rx="2" style="fill:var(--bg);stroke:var(--fg2);stroke-width:1.2"></rect><text x="385" y="160" text-anchor="middle" dominant-baseline="central" style="font:500 13px var(--mono);fill:var(--fg)">{c.desired}</text><text x="300" y="48" text-anchor="start" style="font:11px var(--mono);fill:var(--mute);letter-spacing:.04em">{c.live}</text><rect x="300" y="56" width="170" height="36" rx="2" style="fill:var(--bg);stroke:var(--line);stroke-width:1.2"></rect><a href="#databases"><text x="385" y="74" text-anchor="middle" dominant-baseline="central" style="font:12px var(--mono);fill:var(--acc);cursor:pointer">{c.supported}</text><line x1="309" y1="83" x2="446" y2="83" style="stroke:var(--acc);stroke-width:1;stroke-dasharray:2 2"></line></a><path d="M 470 74 C 515 74, 515 150, 560 150" style="fill:none;stroke:var(--mute);stroke-width:1.2;" marker-end="url(#pl-arrow)"></path><path d="M 470 160 C 515 160, 515 160, 560 160" style="fill:none;stroke:var(--fg2);stroke-width:1.2;" marker-end="url(#pl-arrow)"></path><circle cx="610" cy="160" r="44" style="fill:var(--bg);stroke:var(--fg);stroke-width:1.5"></circle><text x="610" y="154" text-anchor="middle" style="font:600 13px var(--mono);fill:var(--fg)">{c.compare}</text><text x="610" y="171" text-anchor="middle" style="font:10.5px var(--mono);fill:var(--mute)">{c.oneDiff}</text><text x="885" y="48" text-anchor="middle" style="font:11px var(--mono);fill:var(--mute);letter-spacing:.04em">{c.out}</text><path d="M 654 160 C 707 160, 707 79, 760 79" style="fill:none;stroke:var(--fg2);stroke-width:1.2;" marker-end="url(#pl-arrow)"></path><rect x="760" y="64" width="250" height="30" rx="2" style="fill:var(--bg);stroke:var(--fg2);stroke-width:1.2"></rect><text x="885" y="79" text-anchor="middle" dominant-baseline="central" style="font:500 12.5px var(--mono);fill:var(--fg)">schema drift</text><text x="1024" y="83" text-anchor="start" style="font:11px var(--mono);fill:var(--mute);letter-spacing:.04em">{c.proof}</text><g><rect x="1104" y="71" width="18" height="16" rx="2" style="fill:oklch(0.62 0.15 150)"></rect><text x="1113" y="79" text-anchor="middle" dominant-baseline="central" style="font:600 10.5px var(--mono);fill:#111">0</text><rect x="1126" y="71" width="18" height="16" rx="2" style="fill:var(--amber)"></rect><text x="1135" y="79" text-anchor="middle" dominant-baseline="central" style="font:600 10.5px var(--mono);fill:#111">1</text><rect x="1148" y="71" width="18" height="16" rx="2" style="fill:oklch(0.6 0.18 25)"></rect><text x="1157" y="79" text-anchor="middle" dominant-baseline="central" style="font:600 10.5px var(--mono);fill:#111">2</text></g><path d="M 654 160 C 707 160, 707 133, 760 133" style="fill:none;stroke:var(--fg2);stroke-width:1.2;" marker-end="url(#pl-arrow)"></path><rect x="760" y="118" width="250" height="30" rx="2" style="fill:var(--bg);stroke:var(--fg2);stroke-width:1.2"></rect><text x="885" y="133" text-anchor="middle" dominant-baseline="central" style="font:500 12.5px var(--mono);fill:var(--fg)">schema plan · --dry-run</text><text x="1024" y="137" text-anchor="start" style="font:11px var(--mono);fill:var(--mute);letter-spacing:.04em">{c.review}</text><path d="M 654 160 C 707 160, 707 187, 760 187" style="fill:none;stroke:var(--fg2);stroke-width:1.2;" marker-end="url(#pl-arrow)"></path><rect x="760" y="172" width="250" height="30" rx="2" style="fill:var(--bg);stroke:var(--fg2);stroke-width:1.2"></rect><text x="885" y="187" text-anchor="middle" dominant-baseline="central" style="font:500 12.5px var(--mono);fill:var(--fg)">migrations lint</text><text x="1024" y="191" text-anchor="start" style="font:11px var(--mono);fill:var(--mute);letter-spacing:.04em">{c.gate}</text><path d="M 654 160 C 707 160, 707 241, 760 241" style="fill:none;stroke:var(--amber);stroke-width:1.2;" marker-end="url(#pl-arrow-amber)"></path><rect x="760" y="226" width="250" height="30" rx="2" style="fill:var(--bg);stroke:var(--amber);stroke-width:1.2"></rect><text x="885" y="241" text-anchor="middle" dominant-baseline="central" style="font:500 12.5px var(--mono);fill:var(--amber)">schema apply · migrations up</text><text x="1024" y="234" text-anchor="start" style="font:11px var(--mono);fill:var(--amber);letter-spacing:.04em">{c.afterApproval}</text><path d="M 1010 241 H 1156 Q 1176 241 1176 221.0 V 38 Q 1176 18 1156 18 H 460 Q 440 18 440 38 V 48" style="fill:none;stroke:var(--amber);stroke-width:1.2" marker-end="url(#pl-arrow-amber)"></path></svg>
