---
/* The export fan-out from the 5a design: one source, seven targets. The arrow
 * to the selected target takes the accent. */
interface Props { first: string; source: string; sourceSub: string }
const { first, source, sourceSub } = Astro.props;
---
<svg viewBox="0 0 340 380" width="340" height="380" aria-hidden="true"><defs><marker id="ex-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 1 L8 5 L0 9 z" style="fill:var(--line)"></path></marker><marker id="ex-arrow-on" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 1 L8 5 L0 9 z" style="fill:var(--acc)"></path></marker></defs><rect x="24" y="176" width="150" height="44" rx="2" style="fill:var(--bg);stroke:var(--fg);stroke-width:1.5"></rect><text x="99" y="194" text-anchor="middle" style="font:600 13px var(--mono);fill:var(--fg)">{source}</text><text x="99" y="210" text-anchor="middle" style="font:10.5px var(--mono);fill:var(--mute)">{sourceSub}</text><path d="M 174 198 C 260 198, 260 42, 330 42" class:list={["fan-arrow", { "is-on": first === "openapi" }]} data-hl="exp=openapi"></path><path d="M 174 198 C 260 198, 260 94, 330 94" class:list={["fan-arrow", { "is-on": first === "graphql" }]} data-hl="exp=graphql"></path><path d="M 174 198 C 260 198, 260 146, 330 146" class:list={["fan-arrow", { "is-on": first === "proto" }]} data-hl="exp=proto"></path><path d="M 174 198 C 260 198, 260 198, 330 198" class:list={["fan-arrow", { "is-on": first === "md" }]} data-hl="exp=md"></path><path d="M 174 198 C 260 198, 260 250, 330 250" class:list={["fan-arrow", { "is-on": first === "html" }]} data-hl="exp=html"></path><path d="M 174 198 C 260 198, 260 302, 330 302" class:list={["fan-arrow", { "is-on": first === "dbml" }]} data-hl="exp=dbml"></path><path d="M 174 198 C 260 198, 260 354, 330 354" class:list={["fan-arrow", { "is-on": first === "hcl" }]} data-hl="exp=hcl"></path></svg>
